{
  "name": "geuncha",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "mobile:android": "node scripts/mobile.mjs sync android",
    "mobile:local:android": "node scripts/mobile.mjs sync android --local",
    "mobile:local:apk": "node scripts/mobile.mjs apk android --local",
    "screen:test": "node scripts/start.mjs --db portable --lan --open --screen-test",
    "mobile:ios": "node scripts/mobile.mjs sync ios",
    "mobile:apk": "node scripts/mobile.mjs apk android",
    "mobile:open:android": "node scripts/mobile.mjs open android",
    "mobile:open:ios": "node scripts/mobile.mjs open ios",
    "dev:api": "tsx watch apps/api/src/server.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "tsc -p apps/api/tsconfig.json && vite build --config apps/web/vite.config.ts",
    "start": "node scripts/serve.mjs",
    "stop": "node scripts/stop.mjs",
    "setup": "node scripts/start.mjs --setup-only",
    "db:migrate": "tsx apps/api/src/database/migrate.ts",
    "db:seed": "tsx apps/api/src/database/seed.ts",
    "db:portable": "node scripts/portable-db.mjs",
    "typecheck": "tsc --noEmit && tsc -p apps/api/tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "node scripts/integration.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "docs:check": "node scripts/check-docs.mjs",
    "test:e2e": "npm run build && playwright test",
    "installer:build": "node scripts/build-installer.mjs",
    "installer:test": "node scripts/test-installer.mjs",
    "format": "prettier --write apps packages tests scripts playwright.config.ts package.json tsconfig.json"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "leaflet": "^1.9.4",
    "mariadb": "^3.5.5",
    "multer": "^2.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@playwright/test": "^1.65.1",
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.22",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
