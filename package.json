{
  "name": "geuncha",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "tsx watch apps/api/src/server.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "tsc -p apps/api/tsconfig.json && vite build --config apps/web/vite.config.ts",
    "start": "node dist/api/apps/api/src/server.js",
    "setup": "node scripts/start.mjs --setup-only",
    "db:migrate": "tsx apps/api/src/database/migrate.ts",
    "db:seed": "tsx apps/api/src/database/seed.ts",
    "db:portable": "node scripts/portable-db.mjs",
    "typecheck": "tsc --noEmit && tsc -p apps/api/tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "node scripts/integration.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "docs:check": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "mariadb": "^3.5.5",
    "multer": "^2.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
